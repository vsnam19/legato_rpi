diff --git a/Makefile.targetTools b/Makefile.targetTools
index 0341c44..fd6097f 100644
--- a/Makefile.targetTools
+++ b/Makefile.targetTools
@@ -27,9 +27,11 @@ BUILD_PRODUCTS = 	config		\
 					appStopClient	\
 					app \
 					update \
-					sbtrace \
-					scripts \
-					devMode
+					scripts
+
+ifneq ($(TARGET),rpi5)
+BUILD_PRODUCTS += sbtrace devMode
+endif
 
 # Create a list of all proprietary apps, then add them as product to build
 ifneq ($(findstring $(TARGET), wp750x wp85 wp76xx wp77xx),)
@@ -109,6 +111,7 @@ $(LIB_DIR):
 # Currently, the config tool depends on libjansson, which is built using CMake.
 $(LIBJANSSON): $(LIB_DIR)
 	$(Q)mkdir -p $(BUILD_DIR)/libjansson
+ifneq ($(wildcard $(LEGATO_ROOT)/3rdParty/jansson/CMakeLists.txt),)
 	$(L) CMAKE $@
 	$(Q)cd $(BUILD_DIR)/libjansson && \
 		cmake $(LEGATO_ROOT)/3rdParty/jansson \
@@ -122,6 +125,12 @@ $(LIBJANSSON): $(LIB_DIR)
 	$(L) MAKE $@
 	$(Q)make -C $(BUILD_DIR)/libjansson $(VOUTPUT)
 	$(Q)cp -d $(BUILD_DIR)/libjansson/lib/libjansson.so* $(LIB_DIR)
+else
+	$(L) COPY $@
+	$(Q)mkdir -p $(JANSSON_INC_DIR)
+	$(Q)cp -f /usr/include/jansson*.h $(JANSSON_INC_DIR)
+	$(Q)cp -d /usr/lib/aarch64-linux-gnu/libjansson.so* $(LIB_DIR) 2>/dev/null || cp -d /usr/lib/*-linux-gnu*/libjansson.so* $(LIB_DIR) 2>/dev/null || true
+endif
 
 config: $(LIBJANSSON)
 	$(L) MKEXE $(BIN_DIR)/$@
