provides:
{
    api:
    {
        cfgManager = ${PROJECT_ROOT}/vendor/custom/interfaces/cfgManager.api
    }
}

requires:
{
    api:
    {
        le_cfg.api
    }
}

sources:
{
    cfgManagerServer.cpp
    ${PROJECT_ROOT}/vendor/custom/components/cfgManager/core/src/cfgRouter.cpp
    ${PROJECT_ROOT}/vendor/custom/components/cfgManager/core/src/cfgManagerService.cpp
    ${PROJECT_ROOT}/vendor/custom/components/cfgManager/crypto/src/cryptoEngine.cpp
    ${PROJECT_ROOT}/vendor/custom/components/cfgManager/security/src/securityProviderFactory.cpp
    ${PROJECT_ROOT}/vendor/custom/components/cfgManager/security/src/simulatedEnclaveProvider.cpp
    ${PROJECT_ROOT}/vendor/custom/components/cfgManager/security/src/opteeProvider.cpp
    ${PROJECT_ROOT}/vendor/custom/components/cfgManager/storage/src/memoryConfigBackend.cpp
    ${PROJECT_ROOT}/vendor/custom/components/cfgManager/storage/src/configTreeBackend.cpp
    ${PROJECT_ROOT}/vendor/custom/components/cfgManager/events/src/eventDispatcher.cpp
}

cxxflags:
{
    -std=c++20
    -I${PROJECT_ROOT}/vendor/custom/components/cfgManager/core/include
    -I${PROJECT_ROOT}/vendor/custom/components/cfgManager/crypto/include
    -I${PROJECT_ROOT}/vendor/custom/components/cfgManager/security/include
    -I${PROJECT_ROOT}/vendor/custom/components/cfgManager/storage/include
    -I${PROJECT_ROOT}/vendor/custom/components/cfgManager/events/include
}

ldflags:
{
    -lcrypto
    -lssl
    -static-libstdc++
    -static-libgcc
}
