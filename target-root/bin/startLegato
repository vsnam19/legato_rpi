#!/bin/bash
# ==============================================================================
# startLegato - Startup script for Legato AF on Raspberry Pi 5
# ==============================================================================
set -e

# 1. Kernel parameter tuning for Legato IPC
sysctl -w net.unix.max_dgram_qlen=32 >/dev/null 2>&1 || true
sysctl -w net.core.wmem_max=266240 >/dev/null 2>&1 || true
sysctl -w net.core.wmem_default=266240 >/dev/null 2>&1 || true
sysctl -w net.core.rmem_max=266240 >/dev/null 2>&1 || true
sysctl -w net.core.rmem_default=266240 >/dev/null 2>&1 || true

# 2. Ensure essential directories exist
mkdir -p /mnt/flash/legato
mkdir -p /mnt/flash/home
mkdir -p /mnt/legato
mkdir -p /opt/legato/systems
mkdir -p /opt/legato/apps
mkdir -p /var/run/legato
chmod 1777 /var/run/legato 2>/dev/null || true
mkdir -p /tmp/legato
chmod 1777 /tmp/legato 2>/dev/null || true
mkdir -p /var/config
chmod 755 /var/config 2>/dev/null || true

# 3. Ensure /legato symlink
if [ ! -e /legato ]; then
    ln -sf /opt/legato /legato
fi

# Ensure /opt/legato/current points to active system
if [ ! -e /opt/legato/current ] && [ -e /opt/legato/systems/current ]; then
    ln -sf systems/current /opt/legato/current
fi

# 4. Ensure dynamic linker finds Legato shared libraries
if [ ! -f /etc/ld.so.conf.d/legato.conf ]; then
    printf "/opt/legato/current/lib\n/legato/systems/current/lib\n" > /etc/ld.so.conf.d/legato.conf
    ldconfig 2>/dev/null || true
fi

# 5. Launch Legato startSystem / supervisor
if [ -x /legato/systems/current/bin/startSystem ]; then
    cd /legato/systems/current
    VERSION="unknown"
    [ -f version ] && VERSION=$(cat version)
    exec /legato/systems/current/bin/startSystem -v "$VERSION"
elif [ -x /opt/legato/current/bin/startSystem ]; then
    cd /opt/legato/current
    VERSION="unknown"
    [ -f version ] && VERSION=$(cat version)
    exec /opt/legato/current/bin/startSystem -v "$VERSION"
elif [ -x /opt/legato/current/bin/supervisor ]; then
    cd /opt/legato/current
    exec /opt/legato/current/bin/supervisor
else
    echo "ERROR: Legato executables not found under /opt/legato/current/bin" >&2
    exit 1
fi
